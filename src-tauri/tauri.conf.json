{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "46Anarchy",
  "version": "0.1.0",
  "identifier": "fr.46anarchy.launcher",
  "build": {
    "frontendDist": "../crates/ui/frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "46Anarchy — Paladium",
        "width": 1280,
        "height": 750,
        "minWidth": 1150,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://mc-heads.net https://minotar.net; connect-src 'self' ipc: http://ipc.localhost https://cdn.46anarchy.fr"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm", "nsis", "msi", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "publisher": "46Anarchy",
    "copyright": "Copyright © 2026 46Anarchy. License: AGPL-3.0-only."
  }
}
